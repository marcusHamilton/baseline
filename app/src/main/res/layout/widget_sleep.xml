<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:paddingStart="14dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/barlow_condensed_semibold"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="@string/widget_sleep_header"
            android:textColor="#9AA3AE"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/widget_sync_hitbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/widget_sync_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/widget_bg_pill"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/widget_sync_default"
                android:textColor="#C9CFD6"
                android:textSize="11sp" />
        </FrameLayout>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/sleep_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_bg_inner"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/sleep_bedtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/barlow_condensed_semibold"
            android:maxLines="1"
            android:textColor="#C4B5FD"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/sleep_tonight_need"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/sleep_bedtime"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#C9CFD6"
            android:textSize="12sp" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/sleep_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/sleep_footer"
        android:layout_below="@id/widget_header"
        android:layout_marginEnd="6dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingBottom="4dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/sleep_garmin_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:maxLines="1"
                android:textColor="#C4B5FD"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@id/sleep_garmin_score"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sleep_asleep_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:maxLines="1"
                    android:textColor="#F2F4F7"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/sleep_need_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="2dp"
                    android:maxLines="1"
                    android:textColor="#9AA3AE"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/sleep_pct_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:maxLines="1"
                    android:textColor="#A78BFA"
                    android:textSize="14sp" />
            </LinearLayout>
        </RelativeLayout>

        <ImageView
            android:id="@+id/sleep_stage_bar"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="6dp"
            android:contentDescription="@null"
            android:scaleType="fitXY" />
    </LinearLayout>
</RelativeLayout>
