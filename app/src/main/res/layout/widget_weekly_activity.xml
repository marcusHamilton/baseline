<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:paddingStart="14dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <RelativeLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <FrameLayout
            android:id="@+id/widget_sync_hitbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/widget_sync_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/widget_bg_pill"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/widget_sync_default"
                android:textColor="#C9CFD6"
                android:textSize="11sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@id/widget_sync_hitbox"
            android:orientation="vertical">

            <TextView
                android:id="@+id/weekly_header_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/barlow_condensed_semibold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="@string/widget_weekly_default_header"
                android:textColor="#9AA3AE"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/weekly_totals_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#C9CFD6"
                android:textSize="11sp" />
        </LinearLayout>
    </RelativeLayout>

    <ImageView
        android:id="@+id/weekly_strip"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="6dp"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <RelativeLayout
        android:id="@+id/weekly_workout_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/weekly_strip"
        android:layout_below="@id/widget_header"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_bg_inner"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/weekly_empty_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_weekly_no_activities"
            android:textColor="#9AA3AE"
            android:textSize="12sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/weekly_sport_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_bg_sport_icon"
            android:contentDescription="@null"
            android:padding="7dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/weekly_activity_strain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_bg_strain_pill"
            android:fontFamily="@font/barlow_condensed_bold"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="#60A5FA"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/weekly_activity_text_col"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/weekly_activity_strain"
            android:layout_toEndOf="@id/weekly_sport_icon"
            android:orientation="vertical">

            <TextView
                android:id="@+id/weekly_activity_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F2F4F7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/weekly_activity_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#9AA3AE"
                android:textSize="11sp" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
